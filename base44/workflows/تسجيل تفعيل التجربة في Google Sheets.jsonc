{
  "name": "\u062a\u0633\u062c\u064a\u0644 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 \u0641\u064a Google Sheets",
  "description": "\u0639\u0646\u062f \u0625\u0646\u0634\u0627\u0621 \u0627\u0634\u062a\u0631\u0627\u0643 \u062a\u062c\u0631\u064a\u0628\u064a \u062c\u062f\u064a\u062f (free_trial) \u064a\u064f\u0633\u062c\u064e\u0651\u0644 \u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0641\u064a \u062c\u062f\u0648\u0644 Google Sheets",
  "trigger": {
    "condition": "${ (.trigger.data.plan == \"free_trial\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Subscription"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_sheets",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logTrialActivationToSheets",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "logTrialActivationToSheets"
  }
}